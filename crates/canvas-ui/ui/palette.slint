import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Motion, Ease } from "theme/motion.slint";
import { Layout } from "theme/layout.slint";
import { Panel } from "theme/surface.slint";
import { IconSearch, IconPlus, IconCheck, IconSettings, IconNote, IconColumns, IconCalendar } from "theme/icons.slint";

export struct PaletteRow {
    id: string,
    label: string,
    meta: string,
    icon: string,
}

component PaletteGlyph inherits Rectangle {
    in property <string> icon;
    in property <color> stroke-color: Palette.dim;
    width: Layout.icon-size-palette;
    height: Layout.icon-size-palette;

    if root.icon == "plus": IconPlus {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
    if root.icon == "check": IconCheck {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
    if root.icon == "settings": IconSettings {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
    if root.icon == "sticky_note": IconNote {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
    if root.icon == "todo": IconCheck {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
    if root.icon == "kanban": IconColumns {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
    if root.icon == "calendar": IconCalendar {
        size: Layout.icon-size-palette;
        stroke-color: root.stroke-color;
    }
}

export component PaletteWindow inherits Window {
    callback dismissed();
    callback query-changed(string);
    callback activated(string);

    in property <[PaletteRow]> rows: [];
    in property <string> count-label: "";
    in-out property <string> query: "";
    in-out property <int> selected: 0;

    property <length> overlay-height:
        Layout.palette-row-input
        + root.rows.length * Layout.palette-row-result
        + Layout.palette-footer-h;

    function step(delta: int) {
        if (root.rows.length == 0) {
            return;
        }
        root.selected = (root.selected + delta + root.rows.length) .mod(root.rows.length);
    }

    function activate() {
        if (root.rows.length == 0 || root.selected < 0 || root.selected >= root.rows.length) {
            return;
        }
        root.activated(root.rows[root.selected].id);
    }

    no-frame: true;
    background: transparent;
    always-on-top: true;
    title: "Canvas";

    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: Palette.scrim;
    }

    overlay := Panel {
        x: (parent.width - Layout.palette-w) / 2;
        y: parent.height * Layout.palette-top-fraction;
        width: Layout.palette-w;
        height: root.overlay-height;
        corner-radius: Layout.radius-overlay;
        dragging: true;
        clip: true;

        IconSearch {
            x: Layout.pad-doc;
            y: (Layout.palette-row-input - Layout.icon-size-palette) / 2;
            size: Layout.icon-size-palette;
            stroke-color: Palette.dim;
        }

        if root.query == "": Text {
            x: Layout.query-x;
            y: 0;
            width: parent.width - Layout.query-x - Layout.pad-doc;
            height: Layout.palette-row-input;
            text: "TYPE A COMMAND";
            color: Palette.dim;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        query-input := TextInput {
            x: Layout.query-x;
            y: 0;
            width: parent.width - Layout.query-x - Layout.pad-doc;
            height: Layout.palette-row-input;
            text <=> root.query;
            single-line: true;
            vertical-alignment: center;
            color: Palette.text;
            selection-background-color: Palette.edge;
            selection-foreground-color: Palette.text;
            text-cursor-width: 2px;
            font-family: Typography.interface-face;
            font-size: Typography.title-size;
            letter-spacing: Typography.title-tracking;
            edited => {
                root.query-changed(self.text);
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.dismissed();
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.step(-1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.step(1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.activate();
                    return accept;
                }
                return reject;
            }
        }

        for row[i] in root.rows: Rectangle {
            x: 0;
            y: Layout.palette-row-input + i * Layout.palette-row-result;
            width: parent.width;
            height: Layout.palette-row-result;
            background: i == root.selected ? Palette.elev-raised : Colors.transparent;
            animate background { duration: Motion.hover; easing: Ease.standard; }

            row-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                moved => {
                    root.selected = i;
                }
                clicked => {
                    root.selected = i;
                    root.activate();
                }
            }

            PaletteGlyph {
                x: Layout.pad-doc;
                y: (Layout.palette-row-result - Layout.icon-size-palette) / 2;
                icon: row.icon;
                stroke-color: i == root.selected ? Palette.text : Palette.dim;
            }

            Text {
                x: Layout.result-label-x;
                y: 0;
                width: parent.width - Layout.result-label-x - Layout.pad-doc - Layout.result-meta-w;
                height: parent.height;
                text: row.label;
                color: Palette.text;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                vertical-alignment: center;
                overflow: elide;
                wrap: no-wrap;
            }

            Text {
                x: parent.width - Layout.pad-doc - Layout.result-meta-w;
                y: 0;
                width: Layout.result-meta-w;
                height: parent.height;
                text: row.meta;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                vertical-alignment: center;
                horizontal-alignment: right;
                wrap: no-wrap;
            }
        }

        Rectangle {
            x: 0;
            y: parent.height - Layout.palette-footer-h;
            width: parent.width;
            height: Layout.palette-footer-h;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.edge;
            }

            Text {
                x: Layout.pad-doc;
                y: 0;
                height: parent.height;
                text: root.count-label;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                vertical-alignment: center;
                wrap: no-wrap;
            }

            Text {
                x: parent.width - Layout.pad-doc - self.width;
                y: 0;
                height: parent.height;
                text: "UP/DOWN MOVE · ENTER OPEN · ESC CLOSE";
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                vertical-alignment: center;
                horizontal-alignment: right;
                wrap: no-wrap;
            }
        }
    }

    init => {
        query-input.focus();
    }
}
