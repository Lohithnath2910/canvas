import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Motion, Ease } from "theme/motion.slint";
import { Layout } from "theme/layout.slint";
import { Panel } from "theme/surface.slint";
import { GlyphStrip, WidgetState } from "theme/glyphstrip.slint";
import { IconPin, IconTrash, IconX } from "theme/icons.slint";
import { IconButton, Button, ButtonVariant, TextField } from "theme/controls.slint";
import { CardOverlay } from "theme/overlay.slint";
import { TimePicker, DatePicker, DayCell, PickerField } from "theme/pickers.slint";

export struct CalendarChip {
    id: string,
    time: string,
    name: string,
    day: int,
    start: float,
    span: float,
    live: bool,
}

export struct CalendarTick {
    label: string,
    at: float,
}

export component CalendarWindow inherits Window {
    in-out property <string> note-title: "UNTITLED";
    in property <[CalendarChip]> chips: [];
    in property <[CalendarTick]> ticks: [];
    in property <float> now-at: -1.0;
    in property <[string]> day-labels: ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"];
    in property <int> today: -1;
    in property <WidgetState> strip-state: WidgetState.idle;
    in property <int> peer-count: 0;
    in-out property <bool> pinned: false;
    in property <bool> keyboard-focused: false;

    in property <string> info-label: "";
    in property <string> info-name: "";
    in property <string> info-span: "";
    in property <string> info-left: "";
    in property <bool> info-live: false;

    in property <bool> sheet-open: false;
    in property <bool> sheet-existing: false;
    in-out property <string> ev-name: "";
    in-out property <string> ev-location: "";
    in-out property <string> ev-notes: "";
    in property <string> ev-start-label: "";
    in property <string> ev-end-label: "";

    in-out property <int> pick-mode: 0;
    in-out property <int> pick-minute: 0;
    in-out property <int> pick-day: 0;
    in property <string> pick-stamp: "";
    in property <string> pick-month: "";
    in property <[string]> pick-heads: [];
    in property <[DayCell]> pick-days: [];

    callback day-clicked(int, float);
    callback chip-clicked(string);
    callback pick-opened(int);
    callback pick-committed(int);
    callback pick-month-stepped(int);
    callback event-saved();
    callback event-cancelled();
    callback event-deleted();

    callback window-moved(length, length);
    callback drag-started();
    callback drag-ended();
    callback pin-toggled(bool);
    callback delete-confirmed();
    callback title-edited(string);
    callback close-requested();
    callback palette-requested();

    preferred-width: Layout.calendar-w + 2 * Layout.plate-margin;
    preferred-height: Layout.calendar-h + 2 * Layout.plate-margin;
    min-width: 360px + 2 * Layout.plate-margin;
    min-height: 240px + 2 * Layout.plate-margin;
    no-frame: true;
    in-out property <length> resize-border: Layout.resize-border;
    resize-border-width: root.resize-border;
    background: transparent;
    title: "Canvas";

    in-out property <bool> opened: false;
    in-out property <bool> closing: false;

    property <bool> dragging: false;
    property <bool> confirming-delete: false;
    property <bool> editing-title: false;

    property <bool> controls-visible:
        drag-area.has-hover
        || pin-btn.hovered || pin-btn.focused
        || trash-btn.hovered || trash-btn.focused
        || close-btn.hovered || close-btn.focused
        || root.editing-title;

    property <length> confirm-h: Layout.confirm-band;
    property <length> grid-w: plate.width - 2 * Layout.pad;
    property <length> lane-x: Layout.cal-gutter-w;
    property <length> lane-w: root.grid-w - Layout.cal-gutter-w;
    property <length> row-h: (grid.height - Layout.cal-head-h) / 7;
    property <length> info-band: Layout.header-h + Layout.pad;

    plate := Panel {
        x: Layout.plate-margin;
        y: Layout.plate-margin + (root.opened ? 0px : Motion.open-rise);
        width: parent.width - 2 * Layout.plate-margin;
        height: parent.height - 2 * Layout.plate-margin;
        corner-radius: Layout.radius-plate;
        dragging: root.dragging;

        opacity: root.closing ? 0.0 : (root.opened ? 1.0 : 0.0);
        animate y { duration: Motion.open; easing: Ease.standard; }
        animate opacity {
            duration: root.closing ? Motion.close : Motion.open;
            easing: Ease.standard;
        }

        if root.keyboard-focused: Rectangle {
            x: -(Layout.focus-offset + Layout.focus-width);
            y: -(Layout.focus-offset + Layout.focus-width);
            width: parent.width + 2 * (Layout.focus-offset + Layout.focus-width);
            height: parent.height + 2 * (Layout.focus-offset + Layout.focus-width);
            background: transparent;
            border-width: Layout.focus-width;
            border-color: Palette.text;
            border-radius: Layout.radius-plate + Layout.focus-offset + Layout.focus-width;
        }

        grid := Rectangle {
            x: Layout.pad;
            y: Layout.body-top + Layout.pad;
            width: root.grid-w;
            height: parent.height - self.y - Layout.pad - root.info-band
                - (root.confirming-delete ? root.confirm-h : 0px);
            clip: true;

            for tick in root.ticks: Text {
                x: clamp(
                    root.lane-x + tick.at * root.lane-w - self.width / 2,
                    root.lane-x - self.width / 2,
                    root.lane-x + root.lane-w - self.width);
                y: 0;
                width: 34px;
                height: Layout.cal-head-h;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: tick.label;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            for tick in root.ticks: Rectangle {
                x: root.lane-x + tick.at * root.lane-w;
                y: Layout.cal-head-h;
                width: 1px;
                height: parent.height - Layout.cal-head-h;
                background: Palette.edge;
            }

            for day in 7: Rectangle {
                x: 0;
                y: Layout.cal-head-h + day * root.row-h;
                width: parent.width;
                height: root.row-h;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 1px;
                    background: day == root.today ? Palette.text : Palette.edge;
                }

                if day == root.today: Rectangle {
                    x: 0;
                    y: (parent.height - Layout.tag-h) / 2;
                    width: Layout.cal-gutter-w - Layout.icon-gap;
                    height: Layout.tag-h;
                    background: Palette.text;
                    border-radius: Layout.radius-checkbox;
                }

                Text {
                    x: 0;
                    y: 0;
                    width: Layout.cal-gutter-w - Layout.icon-gap;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: root.day-labels[day];
                    color: day == root.today ? Palette.base : Palette.dim;
                    font-family: Typography.interface-face;
                    font-size: Typography.label-size;
                    letter-spacing: Typography.label-tracking;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            for day in 7: TouchArea {
                x: root.lane-x;
                y: Layout.cal-head-h + day * root.row-h;
                width: root.lane-w;
                height: root.row-h;
                enabled: !root.sheet-open && !root.confirming-delete;
                mouse-cursor: pointer;
                clicked => {
                    root.day-clicked(day, self.mouse-x / root.lane-w);
                }
            }

            for chip in root.chips: Rectangle {
                x: root.lane-x + chip.start * root.lane-w;
                y: Layout.cal-head-h + chip.day * root.row-h + Layout.gap-xs;
                width: root.lane-w - chip.start * root.lane-w;
                height: root.row-h - 2 * Layout.gap-xs - 1px;
                background: transparent;

                bar := Rectangle {
                    x: 0;
                    y: 0;
                    width: max(Layout.cal-bar-min, chip.span * root.lane-w);
                    height: parent.height;
                    border-radius: Layout.radius-control;
                    background: chip.live ? Palette.text : Palette.elev-raised;
                    border-width: 1px;
                    border-color: chip.live ? Palette.text : Palette.edge;

                    Text {
                        x: Layout.icon-gap;
                        y: 0;
                        width: parent.width - 2 * Layout.icon-gap;
                        height: parent.height;
                        vertical-alignment: center;
                        text: chip.time;
                        color: chip.live ? Palette.base : Palette.text;
                        font-family: Typography.interface-face;
                        font-size: Typography.label-size;
                        letter-spacing: Typography.label-tracking;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }

                Text {
                    x: bar.width + Layout.icon-gap;
                    y: 0;
                    width: parent.width - self.x - Layout.icon-gap;
                    height: parent.height;
                    vertical-alignment: center;
                    text: chip.name;
                    color: Palette.text;
                    font-family: Typography.body-face;
                    font-size: Typography.body-size;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            if root.now-at >= 0.0: Rectangle {
                x: root.lane-x + root.now-at * root.lane-w;
                y: Layout.cal-head-h;
                width: 1px;
                height: parent.height - Layout.cal-head-h;
                background: Palette.text;
            }

            if root.chips.length == 0: Text {
                x: root.lane-x + Layout.icon-gap;
                y: Layout.cal-head-h + 3 * root.row-h;
                width: root.lane-w;
                height: root.row-h;
                vertical-alignment: center;
                text: "NOTHING HERE YET";
                color: Palette.text;
                opacity: Layout.placeholder-opacity;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        if !root.confirming-delete: Rectangle {
            x: 0;
            y: parent.height - root.info-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        if !root.confirming-delete: Rectangle {
            x: Layout.pad;
            y: parent.height - root.info-band + Layout.header-y;
            width: parent.width - 2 * Layout.pad;
            height: Layout.header-h;

            info-label := Text {
                x: 0;
                y: 0;
                height: parent.height;
                vertical-alignment: center;
                text: root.info-label;
                color: root.info-live ? Palette.text : Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            info-tail := Text {
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                vertical-alignment: center;
                text: root.info-left;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            info-span := Text {
                x: info-tail.x - Layout.gap-m - self.width;
                y: 0;
                height: parent.height;
                vertical-alignment: center;
                text: root.info-span;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            Text {
                x: info-label.width > 0px
                    ? info-label.width + Layout.gap-m
                    : 0px;
                y: 0;
                width: max(0px, info-span.x - Layout.gap-m - self.x);
                height: parent.height;
                vertical-alignment: center;
                text: root.info-name;
                color: Palette.text;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        sheet := CardOverlay {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            card-w: root.pick-mode == 0 ? Layout.card-w : Layout.picker-face + 4 * Layout.pad;
            open: root.sheet-open;
            existing: root.sheet-existing && root.pick-mode == 0;
            save-label: root.pick-mode == 0 ? "SAVE" : "OK";
            delete-label: "DELETE EVENT";
            saved => {
                if (root.pick-mode == 0) {
                    root.event-saved();
                } else {
                    root.pick-committed(root.pick-mode);
                    root.pick-mode = 0;
                }
            }
            cancelled => {
                if (root.pick-mode == 0) {
                    root.event-cancelled();
                } else {
                    root.pick-mode = 0;
                }
            }
            delete-requested => { root.event-deleted(); }

            if root.pick-mode == 0: TextField {
                label: "NAME";
                text <=> root.ev-name;
                accepted(v) => { root.event-saved(); }
            }

            if root.pick-mode == 0: HorizontalLayout {
                spacing: Layout.icon-gap;

                PickerField {
                    label: "START";
                    value: root.ev-start-label;
                    picked => {
                        root.pick-opened(1);
                        root.pick-mode = 1;
                    }
                }

                PickerField {
                    label: "END";
                    value: root.ev-end-label;
                    picked => {
                        root.pick-opened(2);
                        root.pick-mode = 2;
                    }
                }
            }

            if root.pick-mode == 0: TextField {
                label: "LOCATION";
                text <=> root.ev-location;
                accepted(v) => { root.event-saved(); }
            }

            if root.pick-mode == 0: TextField {
                label: "NOTES";
                text <=> root.ev-notes;
                accepted(v) => { root.event-saved(); }
            }

            if root.pick-mode != 0: DatePicker {
                stamp: root.pick-stamp;
                month-label: root.pick-month;
                weekday-heads: root.pick-heads;
                days: root.pick-days;
                selected-day <=> root.pick-day;
                chrome: false;
                month-stepped(delta) => { root.pick-month-stepped(delta); }
            }

            if root.pick-mode != 0: TimePicker {
                minute-of-day <=> root.pick-minute;
                chrome: false;
            }
        }

        pin-btn := IconButton {
            x: parent.width - Layout.pad - Layout.cluster-w;
            y: Layout.header-y;
            width: Layout.icon-size + Layout.icon-gap;
            revealed: root.controls-visible;
            activated => {
                root.pinned = !root.pinned;
                root.pin-toggled(root.pinned);
            }
            IconPin { stroke-color: root.pinned ? Palette.text : pin-btn.glyph-color; }
        }

        trash-btn := IconButton {
            x: close-btn.x - Layout.icon-size - Layout.icon-gap;
            y: Layout.header-y;
            width: Layout.icon-size + Layout.icon-gap;
            revealed: root.controls-visible;
            activated => { root.confirming-delete = true; }
            IconTrash { stroke-color: trash-btn.glyph-color; }
        }

        close-btn := IconButton {
            x: parent.width - Layout.pad - Layout.icon-size;
            y: Layout.header-y;
            width: Layout.icon-size;
            revealed: root.controls-visible;
            activated => { root.close-requested(); }
            IconX { stroke-color: close-btn.glyph-color; }
        }

        drag-area := TouchArea {
            x: 0;
            y: 0;
            width: pin-btn.x - Layout.icon-gap;
            height: Layout.header-band;
            moved => {
                if (!root.dragging) {
                    root.dragging = true;
                    root.drag-started();
                }
                root.window-moved(
                    self.mouse-x - self.pressed-x,
                    self.mouse-y - self.pressed-y
                );
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.drag-ended();
                }
            }
            double-clicked => { root.editing-title = true; }
        }

        Rectangle {
            x: Layout.pad;
            y: Layout.header-y;
            width: Layout.strip-w;
            height: Layout.header-h;
            GlyphStrip {
                x: 0;
                y: (Layout.header-h - Layout.strip-h) / 2;
                width: Layout.strip-w;
                height: Layout.strip-h;
                state: root.strip-state;
                peer-count: root.peer-count;
            }
        }

        if !root.editing-title: Text {
            x: Layout.title-x;
            y: Layout.header-y;
            width: pin-btn.x - Layout.gap-m - self.x;
            height: Layout.header-h;
            text: root.note-title;
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.title-size;
            letter-spacing: Typography.title-tracking;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }

        if root.editing-title: Rectangle {
            x: Layout.title-x - Layout.edit-inset;
            y: Layout.header-y;
            width: pin-btn.x - Layout.gap-m - self.x;
            height: Layout.header-h;
            background: Palette.elev-recessed;
            border-radius: Layout.radius-control;
            border-width: 1px;
            border-color: Palette.edge;

            title-input := TextInput {
                x: Layout.edit-inset;
                y: 0;
                width: parent.width - 2 * Layout.edit-inset;
                height: parent.height;
                text: root.note-title;
                single-line: true;
                vertical-alignment: center;
                color: Palette.text;
                selection-background-color: Palette.edge;
                selection-foreground-color: Palette.text;
                text-cursor-width: Layout.caret-w;
                font-family: Typography.interface-face;
                font-size: Typography.title-size;
                letter-spacing: Typography.title-tracking;
                init => { self.focus(); self.select-all(); }
                edited => { root.title-edited(self.text); }
                accepted => { root.editing-title = false; }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editing-title = false;
                        return accept;
                    }
                    return reject;
                }
            }
        }

        Rectangle {
            x: 0;
            y: Layout.header-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        if root.confirming-delete: Rectangle {
            x: 0;
            y: parent.height - Layout.pad - root.confirm-h;
            width: parent.width;
            height: root.confirm-h;
            background: Palette.plate;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.edge;
            }

            Text {
                x: Layout.pad;
                y: Layout.pad;
                text: "DELETE — CANNOT BE UNDONE";
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            HorizontalLayout {
                x: Layout.pad;
                y: Layout.pad + Typography.label-line + Layout.gap-m;
                height: Layout.button-h;
                spacing: Layout.icon-gap;
                alignment: start;

                Button {
                    label: "DELETE CALENDAR";
                    variant: ButtonVariant.destructive;
                    clicked => { root.delete-confirmed(); }
                }
                Button {
                    label: "CANCEL";
                    variant: ButtonVariant.default;
                    clicked => { root.confirming-delete = false; }
                }
            }

            FocusScope {
                width: 0px;
                height: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.confirming-delete = false;
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}
