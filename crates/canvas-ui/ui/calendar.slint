import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Motion, Ease } from "theme/motion.slint";
import { Layout } from "theme/layout.slint";
import { Panel } from "theme/surface.slint";
import { GlyphStrip, WidgetState } from "theme/glyphstrip.slint";
import { IconPin, IconTrash, IconX } from "theme/icons.slint";
import { IconButton, Button, ButtonVariant } from "theme/controls.slint";

export struct CalendarChip {
    id: string,
    label: string,
    day: int,
    top: float,
    height: length,
    tone: int,
}

export component CalendarWindow inherits Window {
    in-out property <string> note-title: "UNTITLED";
    in property <[CalendarChip]> chips: [];
    in property <[string]> day-labels: ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"];
    in property <int> today: -1;
    in property <WidgetState> strip-state: WidgetState.idle;
    in property <int> peer-count: 0;
    in-out property <bool> pinned: false;
    in property <bool> keyboard-focused: false;

    callback window-moved(length, length);
    callback drag-started();
    callback drag-ended();
    callback pin-toggled(bool);
    callback delete-confirmed();
    callback title-edited(string);
    callback close-requested();
    callback palette-requested();

    preferred-width: Layout.calendar-w + 2 * Layout.plate-margin;
    preferred-height: Layout.calendar-h + 2 * Layout.plate-margin;
    min-width: 360px + 2 * Layout.plate-margin;
    min-height: 240px + 2 * Layout.plate-margin;
    no-frame: true;
    in-out property <length> resize-border: Layout.resize-border;
    resize-border-width: root.resize-border;
    background: transparent;
    title: "Canvas";

    in-out property <bool> opened: false;
    in-out property <bool> closing: false;

    property <bool> dragging: false;
    property <bool> confirming-delete: false;
    property <bool> editing-title: false;

    property <bool> controls-visible:
        drag-area.has-hover
        || pin-btn.hovered || pin-btn.focused
        || trash-btn.hovered || trash-btn.focused
        || close-btn.hovered || close-btn.focused
        || root.editing-title;

    property <length> confirm-h: 75px;
    property <length> grid-w: plate.width - 2 * Layout.pad;
    property <length> column-w:
        (root.grid-w - 6 * Layout.calendar-col-gap) / 7;

    plate := Panel {
        x: Layout.plate-margin;
        y: Layout.plate-margin + (root.opened ? 0px : Motion.open-rise);
        width: parent.width - 2 * Layout.plate-margin;
        height: parent.height - 2 * Layout.plate-margin;
        corner-radius: Layout.radius-plate;
        dragging: root.dragging;

        opacity: root.closing ? 0.0 : (root.opened ? 1.0 : 0.0);
        animate y { duration: Motion.open; easing: Ease.standard; }
        animate opacity {
            duration: root.closing ? Motion.close : Motion.open;
            easing: Ease.standard;
        }

        if root.keyboard-focused: Rectangle {
            x: -(Layout.focus-offset + Layout.focus-width);
            y: -(Layout.focus-offset + Layout.focus-width);
            width: parent.width + 2 * (Layout.focus-offset + Layout.focus-width);
            height: parent.height + 2 * (Layout.focus-offset + Layout.focus-width);
            background: transparent;
            border-width: Layout.focus-width;
            border-color: Palette.text;
            border-radius: Layout.radius-plate + Layout.focus-offset + Layout.focus-width;
        }

        grid := Rectangle {
            x: Layout.pad;
            y: Layout.header-band + 1px + Layout.pad;
            width: root.grid-w;
            height: parent.height - self.y - Layout.pad
                - (root.confirming-delete ? root.confirm-h : 0px);
            clip: true;

            for day in 7: Rectangle {
                x: day * (root.column-w + Layout.calendar-col-gap);
                y: 0;
                width: root.column-w;
                height: parent.height;

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 1px;
                    background: day == root.today ? Palette.text : Palette.edge;
                }

                Text {
                    x: 0;
                    y: 1px;
                    width: parent.width;
                    height: Layout.calendar-label-h;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: root.day-labels[day];
                    color: day == root.today ? Palette.text : Palette.dim;
                    font-family: Typography.interface-face;
                    font-size: Typography.label-size;
                    letter-spacing: Typography.label-tracking;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            for chip in root.chips: Rectangle {
                x: chip.day * (root.column-w + Layout.calendar-col-gap);
                y: Layout.calendar-label-h + 1px + chip.top * max(0px,
                    parent.height - Layout.calendar-label-h - 1px - chip.height);
                width: root.column-w;
                height: chip.height;
                border-radius: Layout.radius-control;
                background: Palette.plate-tone(chip.tone);
                border-width: 1px;
                border-color: Palette.edge;

                Text {
                    x: Layout.icon-gap;
                    y: 0;
                    width: parent.width - 2 * Layout.icon-gap;
                    height: min(parent.height, Layout.calendar-label-h);
                    vertical-alignment: center;
                    text: chip.label;
                    color: Palette.text;
                    font-family: Typography.interface-face;
                    font-size: Typography.label-size;
                    letter-spacing: Typography.label-tracking;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            if root.chips.length == 0: Text {
                x: 0;
                y: Layout.calendar-label-h + Layout.pad;
                width: parent.width;
                text: "NOTHING HERE YET";
                color: Palette.text;
                opacity: Layout.placeholder-opacity;
                horizontal-alignment: center;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        pin-btn := IconButton {
            x: parent.width - Layout.pad - 64px;
            y: Layout.header-y;
            width: Layout.icon-size + Layout.icon-gap;
            revealed: root.controls-visible;
            activated => {
                root.pinned = !root.pinned;
                root.pin-toggled(root.pinned);
            }
            IconPin { stroke-color: root.pinned ? Palette.text : pin-btn.glyph-color; }
        }

        trash-btn := IconButton {
            x: parent.width - Layout.pad - 40px;
            y: Layout.header-y;
            width: Layout.icon-size + Layout.icon-gap;
            revealed: root.controls-visible;
            activated => { root.confirming-delete = true; }
            IconTrash { stroke-color: trash-btn.glyph-color; }
        }

        close-btn := IconButton {
            x: parent.width - Layout.pad - Layout.icon-size;
            y: Layout.header-y;
            width: Layout.icon-size;
            revealed: root.controls-visible;
            activated => { root.close-requested(); }
            IconX { stroke-color: close-btn.glyph-color; }
        }

        drag-area := TouchArea {
            x: 16px;
            y: 6px;
            width: parent.width - Layout.pad - Layout.cluster-w - 16px;
            height: Layout.header-band - 6px;
            moved => {
                if (!root.dragging) {
                    root.dragging = true;
                    root.drag-started();
                }
                root.window-moved(
                    self.mouse-x - self.pressed-x,
                    self.mouse-y - self.pressed-y
                );
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.drag-ended();
                }
            }
            double-clicked => { root.editing-title = true; }
        }

        Rectangle {
            x: Layout.pad;
            y: Layout.header-y;
            width: Layout.strip-w;
            height: Layout.header-h;
            GlyphStrip {
                x: 0;
                y: (Layout.header-h - Layout.strip-h) / 2;
                width: Layout.strip-w;
                height: Layout.strip-h;
                state: root.strip-state;
                peer-count: root.peer-count;
            }
        }

        if !root.editing-title: Text {
            x: Layout.title-x;
            y: Layout.header-y;
            width: parent.width - Layout.pad - Layout.cluster-w - self.x - 12px;
            height: Layout.header-h;
            text: root.note-title;
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.title-size;
            letter-spacing: Typography.title-tracking;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }

        if root.editing-title: Rectangle {
            x: Layout.title-x - 6px;
            y: Layout.header-y;
            width: parent.width - Layout.pad - Layout.cluster-w - self.x - 12px;
            height: Layout.header-h;
            background: Palette.elev-recessed;
            border-radius: Layout.radius-control;
            border-width: 1px;
            border-color: Palette.edge;

            title-input := TextInput {
                x: 6px;
                y: 0;
                width: parent.width - 12px;
                height: parent.height;
                text: root.note-title;
                single-line: true;
                vertical-alignment: center;
                color: Palette.text;
                selection-background-color: Palette.edge;
                selection-foreground-color: Palette.text;
                text-cursor-width: 2px;
                font-family: Typography.interface-face;
                font-size: Typography.title-size;
                letter-spacing: Typography.title-tracking;
                init => { self.focus(); self.select-all(); }
                edited => { root.title-edited(self.text); }
                accepted => { root.editing-title = false; }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editing-title = false;
                        return accept;
                    }
                    return reject;
                }
            }
        }

        Rectangle {
            x: 0;
            y: Layout.header-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        if root.confirming-delete: Rectangle {
            x: 0;
            y: parent.height - Layout.pad - root.confirm-h;
            width: parent.width;
            height: root.confirm-h;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.edge;
            }

            Text {
                x: Layout.pad;
                y: 13px;
                text: "DELETE — CANNOT BE UNDONE";
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            HorizontalLayout {
                x: Layout.pad;
                y: 41px;
                height: 34px;
                spacing: 8px;
                alignment: start;

                Button {
                    label: "DELETE CALENDAR";
                    variant: ButtonVariant.destructive;
                    clicked => { root.delete-confirmed(); }
                }
                Button {
                    label: "CANCEL";
                    variant: ButtonVariant.default;
                    clicked => { root.confirming-delete = false; }
                }
            }

            FocusScope {
                width: 0px;
                height: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.confirming-delete = false;
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }
}
