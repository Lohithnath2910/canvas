import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Layout } from "theme/layout.slint";
import { Panel } from "theme/surface.slint";
import { Checkbox, Tag, Divider, TextField, ScrollBar, Button, ButtonVariant } from "theme/controls.slint";
import { CardOverlay } from "theme/overlay.slint";
import { GlyphStrip, WidgetState } from "theme/glyphstrip.slint";
import { TimePicker, DatePicker, DayCell } from "theme/pickers.slint";

component SectionLabel inherits Text {
    height: Typography.label-line;
    color: Palette.dim;
    font-family: Typography.interface-face;
    font-size: Typography.label-size;
    letter-spacing: Typography.label-tracking;
    wrap: no-wrap;
}

export component GalleryWindow inherits Window {
    preferred-width: 1500px;
    preferred-height: 800px;
    min-width: 400px;
    min-height: 400px;
    background: Palette.base;
    title: "Canvas — component gallery";

    property <length> panel-w: 560px;

    in-out property <bool> box-rest: false;
    in-out property <bool> box-checked: true;
    in-out property <bool> box-done: true;
    in-out property <string> field-plain: "";
    in-out property <string> field-labelled: "Typed value";
    in-out property <string> field-error: "not a number";

    in-out property <int> pick-minute: 9 * 60 + 30;
    in-out property <int> pick-day: 0;
    in property <string> pick-stamp: "";
    in property <string> pick-month: "";
    in property <[string]> pick-heads: [];
    in property <[DayCell]> pick-days: [];
    callback pick-month-stepped(int);
    callback pick-committed();
    in property <string> pick-result: "";

    in-out property <bool> sheet-open: true;
    in-out property <string> sheet-name: "Ship the strip spec";
    in-out property <string> sheet-who: "Mira";
    in-out property <string> sheet-when: "25 AUG";
    in-out property <string> sheet-verdict: "NOTHING SAVED YET";

    Panel {
        x: Layout.pad;
        y: Layout.pad;
        width: root.panel-w - 2 * Layout.pad;
        height: parent.height - 2 * Layout.pad;
        corner-radius: Layout.radius-plate;

        body := Flickable {
            x: Layout.pad - Layout.ring;
            y: Layout.pad - Layout.ring;
            width: parent.width - 2 * Layout.pad - Layout.scroll-gutter + Layout.ring;
            height: parent.height - 2 * Layout.pad + 2 * Layout.ring;
            viewport-height: max(stack.preferred-height, self.height);

            stack := VerticalLayout {
                width: 100%;
                alignment: start;
                spacing: Layout.gap-m;
                padding-left: Layout.ring;
                padding-right: Layout.ring;
                padding-top: Layout.ring;
                padding-bottom: Layout.ring;

                SectionLabel { text: "CHECKBOX — REST · HOVER ME · CHECKED · COMPLETED"; }

                Checkbox {
                    label: "Rest — box elev-recessed, border edge";
                    checked <=> root.box-rest;
                    toggled => { root.box-rest = !root.box-rest; }
                }
                Checkbox {
                    label: "Checked — fill steps to text, no tick glyph";
                    checked <=> root.box-checked;
                    toggled => { root.box-checked = !root.box-checked; }
                }
                Checkbox {
                    label: "Completed — label dim, 1px strike";
                    checked <=> root.box-done;
                    completed: root.box-done;
                    toggled => { root.box-done = !root.box-done; }
                }
                Checkbox {
                    label: "Disabled — whole control at 0.40";
                    enabled: false;
                }

                Rectangle { height: Layout.gap-m; }
                SectionLabel { text: "TAG — REST · ACTIVE"; }

                Rectangle {
                    height: Layout.tag-h;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Layout.icon-gap;
                        Tag { label: "DUE FRI"; }
                        Tag { label: "3 OPEN"; active: true; }
                    }
                }

                Rectangle { height: Layout.gap-m; }
                SectionLabel { text: "DIVIDER — 1PX EDGE, FULL BLEED"; }
                Divider { }

                Rectangle { height: Layout.gap-m; }
                SectionLabel { text: "TEXTFIELD — REST · LABELLED · ERROR · DISABLED"; }

                TextField {
                    placeholder: "Placeholder, hover for dim border";
                    text <=> root.field-plain;
                }
                TextField {
                    label: "WITH A LABEL";
                    text <=> root.field-labelled;
                }
                TextField {
                    label: "ERROR — BORDER ONLY, NO RED TEXT";
                    text <=> root.field-error;
                    error: true;
                }
                TextField {
                    label: "DISABLED";
                    text: "Read only";
                    enabled: false;
                }
            }
        }

        ScrollBar {
            x: parent.width - Layout.pad - Layout.scroll-gutter;
            y: Layout.pad;
            height: parent.height - 2 * Layout.pad;
            view-height: body.height;
            viewport-height: body.viewport-height;
            viewport-y <=> body.viewport-y;
        }
    }

    demo := Panel {
        x: root.panel-w + Layout.pad;
        y: Layout.pad;
        width: Layout.kanban-w;
        height: Layout.kanban-h;
        corner-radius: Layout.radius-plate;

        Rectangle {
            x: Layout.pad;
            y: Layout.header-y;
            width: Layout.strip-w;
            height: Layout.header-h;
            GlyphStrip {
                x: 0;
                y: (Layout.header-h - Layout.strip-h) / 2;
                width: Layout.strip-w;
                height: Layout.strip-h;
                state: root.sheet-open ? WidgetState.focused : WidgetState.idle;
            }
        }

        Text {
            x: Layout.title-x;
            y: Layout.header-y;
            width: parent.width - Layout.title-x - Layout.pad;
            height: Layout.header-h;
            vertical-alignment: center;
            text: "CARD OVERLAY";
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.title-size;
            letter-spacing: Typography.title-tracking;
            overflow: elide;
            wrap: no-wrap;
        }

        Rectangle {
            x: 0;
            y: Layout.header-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        board := Rectangle {
            x: Layout.pad;
            y: Layout.body-top + Layout.pad;
            width: parent.width - 2 * Layout.pad;
            height: parent.height - self.y - Layout.pad;
            clip: true;

            for col[idx] in ["TODO", "DOING", "DONE"]: Rectangle {
                x: idx * (parent.width + Layout.kanban-col-gap) / 3;
                y: 0;
                width: (parent.width - 2 * Layout.kanban-col-gap) / 3;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0;
                    y: 0;
                    height: Layout.kanban-col-head-h - 1px;
                    vertical-alignment: center;
                    text: col;
                    color: Palette.text;
                    font-family: Typography.interface-face;
                    font-size: Typography.label-size;
                    letter-spacing: Typography.label-tracking;
                    wrap: no-wrap;
                }

                Rectangle {
                    x: 0;
                    y: Layout.kanban-col-head-h - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Palette.edge;
                }

                Rectangle {
                    x: 0;
                    y: Layout.kanban-col-head-h + Layout.kanban-card-gap;
                    width: parent.width;
                    height: Layout.kanban-card-h;
                    background: Palette.elev-raised;
                    border-width: 1px;
                    border-color: Palette.edge;
                    border-radius: Layout.radius-control;

                    Text {
                        x: Layout.kanban-card-pad;
                        y: Layout.kanban-card-pad;
                        width: parent.width - 2 * Layout.kanban-card-pad;
                        height: Layout.checkbox-row-h;
                        vertical-alignment: center;
                        text: "Behind the card";
                        color: Palette.text;
                        font-family: Typography.body-face;
                        font-size: Typography.body-size;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            Text {
                x: 0;
                y: parent.height - Typography.label-line;
                width: parent.width - Layout.result-meta-w - Layout.gap-m;
                height: Typography.label-line;
                vertical-alignment: center;
                text: root.sheet-verdict;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                overflow: elide;
                wrap: no-wrap;
            }

            open-btn := Button {
                x: parent.width - self.width;
                y: parent.height - self.height;
                label: "OPEN SHEET";
                variant: ButtonVariant.default;
                enabled: !root.sheet-open;
                clicked => {
                    root.sheet-verdict = "CARD OPEN";
                    root.sheet-open = true;
                }
            }
        }

        sheet := CardOverlay {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            open: root.sheet-open;
            existing: true;
            delete-label: "DELETE CARD";
            saved => {
                root.sheet-verdict = "SAVED — " + root.sheet-name;
                root.sheet-open = false;
            }
            cancelled => {
                root.sheet-verdict = "CANCELLED";
                root.sheet-open = false;
            }
            delete-requested => {
                root.sheet-verdict = "DELETE REQUESTED";
                root.sheet-open = false;
            }

            TextField {
                label: "NAME";
                text <=> root.sheet-name;
                accepted(v) => { sheet.saved(); }
            }
            TextField {
                label: "ASSIGNEE";
                text <=> root.sheet-who;
                accepted(v) => { sheet.saved(); }
            }
            TextField {
                label: "DUE";
                text <=> root.sheet-when;
                accepted(v) => { sheet.saved(); }
            }
        }
    }

    pickers := Panel {
        x: demo.x + demo.width + Layout.pad;
        y: Layout.pad;
        width: Layout.picker-face + 2 * Layout.pad;
        height: 4 * Layout.pad + 1px + 2 * (Layout.header-band + Layout.pad
            + Layout.picker-face + Layout.pad + Layout.button-h)
            + Layout.icon-gap + Typography.label-line;
        corner-radius: Layout.radius-plate;

        time-pick := TimePicker {
            x: Layout.pad;
            y: Layout.pad;
            minute-of-day <=> root.pick-minute;
            accepted => { root.pick-committed(); }
        }

        Rectangle {
            x: Layout.pad;
            y: time-pick.y + time-pick.height + Layout.pad;
            width: parent.width - 2 * Layout.pad;
            height: 1px;
            background: Palette.edge;
        }

        date-pick := DatePicker {
            x: Layout.pad;
            y: time-pick.y + time-pick.height + Layout.pad + 1px + Layout.pad;
            stamp: root.pick-stamp;
            month-label: root.pick-month;
            weekday-heads: root.pick-heads;
            days: root.pick-days;
            selected-day <=> root.pick-day;
            month-stepped(delta) => { root.pick-month-stepped(delta); }
            accepted => { root.pick-committed(); }
        }

        Text {
            x: Layout.pad;
            y: date-pick.y + date-pick.height + Layout.icon-gap;
            width: parent.width - 2 * Layout.pad;
            height: Typography.label-line;
            vertical-alignment: center;
            text: root.pick-result;
            color: Palette.dim;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}
