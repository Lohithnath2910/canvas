
import { Palette } from "palette.slint";
import { Typography } from "typography.slint";
import { Motion, Ease } from "motion.slint";
import { Layout } from "layout.slint";

export component IconButton inherits Rectangle {
    in property <bool> revealed: true;
    callback activated();

    out property <bool> hovered: touch.has-hover;
    out property <bool> focused: focus.has-focus;

    out property <color> glyph-color: (touch.has-hover || focus.has-focus)
        ? Palette.text
        : Palette.dim;

    height: Layout.header-h;

    public function take-focus() { focus.focus(); }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.activated();
        }
    }

    if focus.has-focus: Rectangle {
        x: -Layout.focus-offset - Layout.focus-width;
        y: (parent.height - Layout.icon-size) / 2 - Layout.focus-offset - Layout.focus-width;
        width: Layout.icon-size + 2 * (Layout.focus-offset + Layout.focus-width);
        height: Layout.icon-size + 2 * (Layout.focus-offset + Layout.focus-width);
        background: transparent;
        border-width: Layout.focus-width;
        border-color: Palette.text;
        border-radius: Layout.radius-control + Layout.focus-offset + Layout.focus-width;
    }

    Rectangle {
        x: 0;
        y: (parent.height - Layout.icon-size) / 2;
        width: Layout.icon-size;
        height: Layout.icon-size;
        opacity: (root.revealed || focus.has-focus) ? 1.0 : 0.0;
        animate opacity { duration: Motion.hover; easing: Ease.standard; }
        @children
    }
}

export enum ButtonVariant { default, primary, destructive }

export component Button inherits Rectangle {
    in property <string> label;
    in property <ButtonVariant> variant: ButtonVariant.default;
    in property <bool> enabled: true;
    callback clicked();

    out property <bool> focused: focus.has-focus;

    property <bool> is-primary: root.variant == ButtonVariant.primary;
    property <bool> is-destructive: root.variant == ButtonVariant.destructive;
    property <bool> pressed: touch.pressed && root.enabled;
    property <bool> hovered: touch.has-hover && root.enabled;

    height: 34px;
    width: text-label.width + 32px;
    border-radius: Layout.radius-control;
    border-width: 1px;

    border-color: root.is-destructive ? Palette.signal : Palette.edge;

    background:
        root.is-destructive
            ? (root.pressed || root.hovered ? Palette.active-destructive : Palette.elev-raised)
        : root.is-primary
            ? (root.pressed ? Palette.active-primary
                : root.hovered ? Palette.hover-primary
                : Palette.text)
        : (root.pressed ? Palette.elev-recessed
            : root.hovered ? Palette.hover-default
            : Palette.elev-raised);

    opacity: root.enabled ? 1.0 : 0.40;

    animate background { duration: Motion.press; easing: Ease.standard; }

    text-label := Text {
        x: 16px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.is-destructive
            ? (root.pressed || root.hovered ? Palette.text : Palette.signal)
            : root.is-primary ? Palette.base
            : Palette.text;
        font-family: Typography.interface-face;
        font-size: Typography.label-size;
        letter-spacing: Typography.label-tracking;
        wrap: no-wrap;
    }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }

    if focus.has-focus: Rectangle {
        x: -Layout.focus-offset - Layout.focus-width;
        y: -Layout.focus-offset - Layout.focus-width;
        width: parent.width + 2 * (Layout.focus-offset + Layout.focus-width);
        height: parent.height + 2 * (Layout.focus-offset + Layout.focus-width);
        background: transparent;
        border-width: Layout.focus-width;
        border-color: Palette.text;
        border-radius: Layout.radius-control + Layout.focus-offset + Layout.focus-width;
    }
}

export component ScrollBar inherits Rectangle {
    in property <length> viewport-height: 0px;
    in property <length> view-height: 0px;
    in-out property <length> viewport-y: 0px;

    property <length> overflow: max(0px, root.viewport-height - root.view-height);
    property <bool> scrollable: root.overflow > 0px;
    property <length> thumb-h: root.scrollable
        ? max(Layout.scroll-thumb-min, root.height * (root.view-height / root.viewport-height))
        : 0px;
    property <length> travel: max(0px, root.height - root.thumb-h);
    property <length> thumb-y: root.travel > 0px
        ? root.travel * (-root.viewport-y / root.overflow)
        : 0px;
    property <length> press-origin: 0px;

    width: Layout.scroll-gutter;
    opacity: root.scrollable ? 1.0 : 0.0;
    animate opacity { duration: Motion.hover; easing: Ease.standard; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.scrollable;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.press-origin = root.viewport-y;
            }
        }
        moved => {
            if (root.travel > 0px) {
                root.viewport-y = max(-root.overflow, min(0px,
                    root.press-origin
                        - (self.mouse-y - self.pressed-y) * (root.overflow / root.travel)));
            }
        }
    }

    thumb := Rectangle {
        x: (parent.width - Layout.scroll-thumb-w) / 2;
        y: root.thumb-y;
        width: Layout.scroll-thumb-w;
        height: root.thumb-h;
        border-radius: Layout.radius-checkbox;
        background: (touch.pressed || touch.has-hover) ? Palette.text : Palette.dim;
        animate background { duration: Motion.hover; easing: Ease.standard; }
    }
}
