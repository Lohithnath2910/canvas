
import { Palette } from "palette.slint";
import { Motion, Ease } from "motion.slint";

export component Panel inherits Rectangle {
    in property <length> corner-radius: 20px;
    in property <bool> dragging: false;

    in property <int> tone: 0;

    background: Palette.plate-tone(root.tone).with-alpha(0.96);
    border-radius: root.corner-radius;
    border-width: 1px;
    border-color: Palette.edge;

    drop-shadow-offset-y: root.dragging
        ? Palette.shadow-offset-y-drag
        : Palette.shadow-offset-y;
    drop-shadow-blur: root.dragging
        ? Palette.shadow-blur-drag
        : Palette.shadow-blur;
    drop-shadow-color: root.dragging
        ? Palette.shadow-color-drag
        : Palette.shadow-color;

    animate drop-shadow-offset-y, drop-shadow-blur, drop-shadow-color {
        duration: Motion.drag-shadow;
        easing: Ease.standard;
    }

    @children
}
