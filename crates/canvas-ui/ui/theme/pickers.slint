import { Palette } from "palette.slint";
import { Typography } from "typography.slint";
import { Motion, Ease } from "motion.slint";
import { Layout } from "layout.slint";
import { Button, ButtonVariant, IconButton } from "controls.slint";
import { IconChevronLeft, IconChevronRight } from "icons.slint";

export struct DayCell {
    label: string,
    epoch-day: int,
    in-month: bool,
    today: bool,
}

export component DatePicker inherits Rectangle {
    in property <string> stamp: "";
    in property <string> month-label: "";
    in property <[string]> weekday-heads: [];
    in property <[DayCell]> days: [];
    in-out property <int> selected-day: 0;
    in property <string> save-label: "OK";
    in property <bool> chrome: true;
    callback month-stepped(int);
    callback accepted();
    callback cancelled();

    property <length> head-h: Layout.header-band;
    property <length> nav-h: Layout.picker-row-h;
    property <length> col-w: Layout.picker-face / 7;
    property <length> grid-h: 6 * Layout.picker-row-h;

    width: Layout.picker-face;
    height: root.head-h + 1px + 2 * root.nav-h + root.grid-h
        + (root.chrome ? Layout.pad + Layout.button-h : 0px);
    background: Colors.transparent;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.head-h;
        vertical-alignment: center;
        text: root.stamp;
        color: Palette.text;
        font-family: Typography.interface-face;
        font-size: Typography.title-size;
        letter-spacing: Typography.title-tracking;
        overflow: elide;
        wrap: no-wrap;
    }

    Rectangle {
        x: 0;
        y: root.head-h;
        width: parent.width;
        height: 1px;
        background: Palette.edge;
    }

    Rectangle {
        x: 0;
        y: root.head-h + 1px;
        width: parent.width;
        height: root.nav-h;

        prev-btn := IconButton {
            x: 0;
            y: (parent.height - Layout.icon-size) / 2 - Layout.header-y;
            width: Layout.icon-size;
            activated => { root.month-stepped(-1); }
            IconChevronLeft { stroke-color: prev-btn.glyph-color; }
        }

        Text {
            x: Layout.icon-size + Layout.icon-gap;
            y: 0;
            width: parent.width - 2 * (Layout.icon-size + Layout.icon-gap);
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.month-label;
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
            overflow: elide;
            wrap: no-wrap;
        }

        next-btn := IconButton {
            x: parent.width - Layout.icon-size;
            y: (parent.height - Layout.icon-size) / 2 - Layout.header-y;
            width: Layout.icon-size;
            activated => { root.month-stepped(1); }
            IconChevronRight { stroke-color: next-btn.glyph-color; }
        }
    }

    Rectangle {
        x: 0;
        y: root.head-h + 1px + root.nav-h;
        width: parent.width;
        height: root.nav-h;

        for head[idx] in root.weekday-heads: Text {
            x: idx * root.col-w;
            y: 0;
            width: root.col-w;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: head;
            color: Palette.dim;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
        }
    }

    Rectangle {
        x: 0;
        y: root.head-h + 1px + 2 * root.nav-h;
        width: parent.width;
        height: root.grid-h;

        for cell[idx] in root.days: slot := Rectangle {
            property <bool> selected: root.selected-day == cell.epoch-day;

            x: mod(idx, 7) * root.col-w;
            y: floor(idx / 7) * Layout.picker-row-h;
            width: root.col-w;
            height: Layout.picker-row-h;

            if cell.today: Rectangle {
                x: (parent.width - Layout.picker-cell) / 2;
                y: 0;
                width: Layout.picker-cell;
                height: 1px;
                background: Palette.text;
            }

            Rectangle {
                x: (parent.width - Layout.picker-cell) / 2;
                y: (parent.height - Layout.picker-cell) / 2;
                width: Layout.picker-cell;
                height: Layout.picker-cell;
                border-radius: Layout.radius-pill;
                background: slot.selected ? Palette.text : Colors.transparent;

                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: cell.label;
                    color: slot.selected ? Palette.base : Palette.text;
                    opacity: cell.in-month ? 1.0 : Layout.placeholder-opacity;
                    font-family: Typography.body-face;
                    font-size: Typography.body-size;
                }
            }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected-day = cell.epoch-day; }
            }
        }
    }

    if root.chrome: HorizontalLayout {
        x: 0;
        y: parent.height - Layout.button-h;
        width: parent.width;
        height: Layout.button-h;
        spacing: Layout.icon-gap;
        alignment: end;

        Button {
            label: "CANCEL";
            variant: ButtonVariant.default;
            clicked => { root.cancelled(); }
        }

        Button {
            label: root.save-label;
            variant: ButtonVariant.primary;
            clicked => { root.accepted(); }
        }
    }
}


export component PickerField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> enabled: true;
    callback picked();

    height: Typography.label-line + Layout.field-gap + Layout.field-h;
    background: Colors.transparent;

    Text {
        x: 0;
        y: 0;
        width: parent.width;
        height: Typography.label-line;
        vertical-alignment: center;
        text: root.label;
        color: Palette.dim;
        font-family: Typography.interface-face;
        font-size: Typography.label-size;
        letter-spacing: Typography.label-tracking;
        wrap: no-wrap;
    }

    box := Rectangle {
        x: 0;
        y: Typography.label-line + Layout.field-gap;
        width: parent.width;
        height: Layout.field-h;
        border-radius: Layout.radius-control;
        border-width: 1px;
        border-color: (touch.has-hover || focus.has-focus) ? Palette.dim : Palette.edge;
        background: Palette.elev-recessed;
        animate border-color { duration: Motion.hover; easing: Ease.standard; }

        Text {
            x: Layout.field-pad-x;
            y: 0;
            width: parent.width - 2 * Layout.field-pad-x;
            height: parent.height;
            vertical-alignment: center;
            text: root.value;
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
            overflow: elide;
            wrap: no-wrap;
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.picked(); }
        }
    }

    focus := FocusScope {
        x: 0;
        y: box.y;
        width: 0px;
        height: box.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.picked();
                return accept;
            }
            return reject;
        }
    }

    if focus.has-focus: Rectangle {
        x: -Layout.ring;
        y: box.y - Layout.ring;
        width: parent.width + 2 * Layout.ring;
        height: box.height + 2 * Layout.ring;
        background: Colors.transparent;
        border-width: Layout.focus-width;
        border-color: Palette.text;
        border-radius: Layout.radius-control + Layout.ring;
    }
}
