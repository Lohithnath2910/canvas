
export global Palette {

    in-out property <bool> is-dark: true;

    out property <color> base: root.is-dark ? #000000 : #FFFFFF;

    out property <color> plate: root.is-dark ? #121212 : #F2F2F2;

    out property <color> text: root.is-dark ? #FFFFFF : #0A0A0A;

    out property <color> dim: root.is-dark
        ? rgba(255, 255, 255, 0.52)
        : rgba(10, 10, 10, 0.58);

    out property <color> edge: root.is-dark
        ? rgba(255, 255, 255, 0.14)
        : rgba(10, 10, 10, 0.12);

    out property <color> signal: #D71921;

    out property <color> elev-raised: root.is-dark ? #1C1C1C : #FFFFFF;
    out property <color> elev-base: root.is-dark ? #121212 : #F2F2F2;
    out property <color> elev-recessed: root.is-dark ? #0C0C0C : #E8E8E8;

    out property <color> dot-lit: root.text;
    out property <color> dot-half: root.dim;
    out property <color> dot-signal: root.signal;

    out property <color> dot-unlit: root.is-dark
        ? rgba(255, 255, 255, 0.14)
        : rgba(10, 10, 10, 0.22);

    out property <color> peer-1: root.is-dark ? #3A3A3A : #C8C8C8;
    out property <color> peer-2: root.is-dark ? #2E2E2E : #D4D4D4;
    out property <color> peer-3: root.is-dark ? #242424 : #E0E0E0;
    out property <color> peer-4: root.is-dark ? #1C1C1C : #EAEAEA;

    out property <color> plate-tone-1: root.peer-4;
    out property <color> plate-tone-2: root.peer-3;
    out property <color> plate-tone-3: root.peer-2;
    out property <color> plate-tone-4: root.peer-1;

    public pure function plate-tone(tone: int) -> color {
        return tone == 1 ? root.plate-tone-1
            : tone == 2 ? root.plate-tone-2
            : tone == 3 ? root.plate-tone-3
            : tone == 4 ? root.plate-tone-4
            : root.plate;
    }

    out property <color> hover-default: root.is-dark ? #242424 : #E8E8E8;
    out property <color> hover-primary: root.is-dark ? #E6E6E6 : #242424;
    out property <color> active-primary: root.is-dark ? #CCCCCC : #3A3A3A;
    out property <color> active-destructive: #B01319;

    out property <color> scrim: rgba(0, 0, 0, 0.72);

    out property <color> shadow-color: root.is-dark
        ? rgba(0, 0, 0, 0.40)
        : rgba(0, 0, 0, 0.10);
    out property <color> shadow-color-drag: root.is-dark
        ? rgba(0, 0, 0, 0.40)
        : rgba(0, 0, 0, 0.20);

    out property <length> shadow-offset-y: root.is-dark ? 2px : 1px;
    out property <length> shadow-blur: root.is-dark ? 16px : 3px;
    out property <length> shadow-offset-y-drag: root.is-dark ? 8px : 6px;
    out property <length> shadow-blur-drag: root.is-dark ? 28px : 20px;
}
