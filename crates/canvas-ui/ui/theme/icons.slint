
import { Palette } from "palette.slint";
import { Motion } from "motion.slint";

component IconGlyph inherits Rectangle {
    in property <color> stroke-color: Palette.dim;
    width: 16px;
    height: 16px;
    @children
}

export component IconPalette inherits IconGlyph {
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M2.75 13.25 L13.25 2.75 L13.25 13.25 Z";
        fill: root.stroke-color;
        stroke-width: 0px;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M2.75 2.75 H13.25 V13.25 H2.75 Z";
        fill: transparent;
        stroke: root.stroke-color;
        stroke-width: 1.5px;
    }
}

