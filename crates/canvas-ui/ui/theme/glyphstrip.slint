import { Palette } from "palette.slint";
import { Motion } from "motion.slint";
import { Layout } from "layout.slint";

export enum WidgetState {
    idle,
    focused,
    syncing,
    offline,
    peers,
    peers-idle,
    error,
}

component DotCell inherits Rectangle {
    width: Layout.dot-size;
    height: Layout.dot-size;
}

export component GlyphStrip inherits HorizontalLayout {
    in property <WidgetState> state: WidgetState.idle;
    in property <int> peer-count: 0;

    spacing: Layout.dot-gap;

    property <int> sync-step: 0;
    property <int> lit-peers: root.peer-count > 5 ? 5 : root.peer-count;

    Timer {
        interval: Motion.dot-step;
        running: root.state == WidgetState.syncing && !Motion.reduced;
        triggered => {
            root.sync-step = root.sync-step >= 4 ? 0 : root.sync-step + 1;
        }
    }

    for i in 5: DotCell {
        background:
            root.state == WidgetState.error
                ? (i == 2 ? Palette.dot-signal : Palette.dot-unlit)
            : root.state == WidgetState.focused
                ? Palette.dot-lit
            : root.state == WidgetState.offline
                ? Palette.dot-half
            : root.state == WidgetState.syncing
                ? (i == root.sync-step ? Palette.dot-lit : Palette.dot-unlit)
            : (root.state == WidgetState.peers || root.state == WidgetState.peers-idle)
                ? (i >= 5 - root.lit-peers
                    ? (root.state == WidgetState.peers-idle
                        ? Palette.dot-half
                        : Palette.dot-lit)
                    : Palette.dot-unlit)
            : (i == 0 ? Palette.dot-half : Palette.dot-unlit);
    }
}
