import { TextEdit } from "std-widgets.slint";
import { GlassPanel, WidgetState } from "theme/materials.slint";
import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Spacing } from "theme/spacing.slint";
import { Radius } from "theme/radius.slint";
import { Motion } from "theme/motion.slint";

export { WidgetState }

export component MainWindow inherits Window {
    width: 300px;
    height: 300px;
    title: "Canvas Sticky Note";
    no-frame: true;
    background: transparent;

    in-out property <string> note-text: "";
    in property <WidgetState> sync-state: WidgetState.idle;
    callback text-changed(string);
    callback window-moved(length, length);

    GlassPanel {
        corner-radius: Radius.sticky-note;
        state: root.sync-state != WidgetState.idle ? root.sync-state : 
               text-input.has-focus ? WidgetState.focused : WidgetState.idle;

        // Invisible drag area at the top 24px
        TouchArea {
            y: 0;
            width: 100%;
            height: 24px;
            moved => {
                root.window-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }

        // Note content
        VerticalLayout {
            padding: Spacing.normal;
            padding-top: 24px; // leave space for drag area
            
            Rectangle {
                border-radius: Radius.control;
                border-width: 2px;
                border-color: text-input.has-focus ? Palette.canvas-verdigris : transparent;
                animate border-color { duration: Motion.micro; }

                VerticalLayout {
                    padding: Spacing.base; // Give the text breathing room inside the control
                    
                    Flickable {
                        viewport-height: text-input.preferred-height;
                        text-input := TextInput {
                            text: root.note-text;
                            font-size: Typography.body-size;
                            font-family: Typography.system-sans;
                            wrap: word-wrap;
                            color: Palette.canvas-ink;
                            single-line: false;
                            edited => {
                                root.note-text = self.text;
                                root.text-changed(self.text);
                            }
                        }
                    }
                }
            }
        }
    }
}
