import { TextEdit } from "std-widgets.slint";
import { GlassPanel, WidgetState } from "theme/materials.slint";
import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Spacing } from "theme/spacing.slint";
import { Radius } from "theme/radius.slint";
import { Motion } from "theme/motion.slint";

export { WidgetState }

export component MainWindow inherits Window {
    width: 300px;
    height: 300px;
    title: "Canvas Sticky Note";
    no-frame: true;
    background: transparent;

    in-out property <string> note-text: "";
    in property <WidgetState> sync-state: WidgetState.idle;
    callback text-changed(string);
    callback window-moved(length, length);
    callback new-widget-requested();
    callback close-widget-requested();

    GlassPanel {
        corner-radius: Radius.sticky-note;
        state: root.sync-state != WidgetState.idle ? root.sync-state : 
               text-input.has-focus ? WidgetState.focused : WidgetState.idle;

        VerticalLayout {
            width: 100%;
            height: 100%;

            // Top bar for dragging and actions
            HorizontalLayout {
                height: 24px;
                
                // Drag area
                TouchArea {
                    moved => {
                        root.window-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
                
                // Action buttons
                HorizontalLayout {
                    width: 48px;
                    
                    // New widget button
                    Rectangle {
                        width: 24px;
                        background: btn-add.pressed ? Palette.canvas-verdigris.with-alpha(0.5) : 
                                   (btn-add.has-hover ? Palette.canvas-verdigris.with-alpha(0.2) : transparent);
                        Text {
                            text: "+";
                            color: Palette.canvas-ink;
                            font-size: Typography.title-size;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn-add := TouchArea {
                            clicked => {
                                root.new-widget-requested();
                            }
                        }
                    }

                    // Close button
                    Rectangle {
                        width: 24px;
                        background: btn-close.pressed ? Palette.canvas-brick.with-alpha(0.5) : 
                                   (btn-close.has-hover ? Palette.canvas-brick.with-alpha(0.2) : transparent);
                        border-top-right-radius: Radius.sticky-note;
                        Text {
                            text: "×";
                            color: Palette.canvas-ink;
                            font-size: Typography.title-size;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn-close := TouchArea {
                            clicked => {
                                root.close-widget-requested();
                            }
                        }
                    }
                }
            }

            // Note content
            VerticalLayout {
                padding: Spacing.normal;
                padding-top: 0; // removed since top bar takes space
                
                Rectangle {
                    border-radius: Radius.control;
                    border-width: 2px;
                    border-color: text-input.has-focus ? Palette.canvas-verdigris : transparent;
                    animate border-color { duration: Motion.micro; }

                    VerticalLayout {
                        padding: Spacing.base; // Give the text breathing room inside the control
                        
                        Flickable {
                            viewport-height: text-input.preferred-height;
                            text-input := TextInput {
                                text: root.note-text;
                                font-size: Typography.body-size;
                                font-family: Typography.system-sans;
                                wrap: word-wrap;
                                color: Palette.canvas-ink;
                                single-line: false;
                                edited => {
                                    root.note-text = self.text;
                                    root.text-changed(self.text);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
