import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Motion, Ease } from "theme/motion.slint";
import { Layout } from "theme/layout.slint";
import { Panel } from "theme/surface.slint";
import { GlyphStrip, PriorityDots, WidgetState } from "theme/glyphstrip.slint";
import { IconPin, IconTrash, IconX, IconPlus } from "theme/icons.slint";
import { IconButton, Button, ButtonVariant, ScrollBar, Checkbox, Tag } from "theme/controls.slint";

export struct TodoItemData {
    id: string,
    text: string,
    done: bool,
    due: string,
    priority: int,
}

component ItemRow inherits Rectangle {
    in property <TodoItemData> item;
    in property <bool> editing: false;
    callback toggled();
    callback text-edited(string);
    callback commit();
    callback remove();
    callback begin-edit();
    callback priority-cycled();
    callback drag-moved(length);
    callback drag-ended();

    in property <bool> held: false;

    height: Layout.todo-row-h;
    opacity: root.held ? Layout.placeholder-opacity : 1.0;

    out property <bool> hovered: touch.has-hover || del.hovered || del.focused;

    property <bool> show-tag: root.item.due != "" && !root.editing;
    property <length> tag-w: root.show-tag ? due-tag.width + Layout.icon-gap : 0px;
    property <length> dots-w: 3 * Layout.dot-size + 2 * Layout.dot-gap + Layout.icon-gap;
    property <length> tail: Layout.icon-size + Layout.icon-gap + root.tag-w + root.dots-w;

    touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width - Layout.icon-size - Layout.icon-gap;
        height: parent.height;
        enabled: !root.editing;
        mouse-cursor: root.held ? grabbing : default;
        double-clicked => { root.begin-edit(); }
        moved => { root.drag-moved(self.mouse-y - self.pressed-y); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.drag-ended();
            }
        }
    }

    if !root.editing: Checkbox {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.tail;
        label: root.item.text;
        checked: root.item.done;
        completed: root.item.done;
        toggled => { root.toggled(); }
    }

    if root.editing: Rectangle {
        x: Layout.checkbox-size + Layout.checkbox-gap;
        y: 0;
        width: parent.width - self.x - root.tail;
        height: parent.height;
        background: Palette.elev-recessed;
        border-radius: Layout.radius-control;
        border-width: 1px;
        border-color: Palette.edge;

        edit-input := TextInput {
            x: Layout.edit-inset;
            y: 0;
            width: parent.width - 2 * Layout.edit-inset;
            height: parent.height;
            text: root.item.text;
            single-line: true;
            vertical-alignment: center;
            color: Palette.text;
            selection-background-color: Palette.edge;
            selection-foreground-color: Palette.text;
            text-cursor-width: Layout.caret-w;
            font-family: Typography.body-face;
            font-size: Typography.body-size;
            init => { self.focus(); self.select-all(); }
            edited => { root.text-edited(self.text); }
            accepted => { root.commit(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.commit();
                    return accept;
                }
                return reject;
            }
        }
    }

    due-tag := Tag {
        x: parent.width - Layout.icon-size - Layout.icon-gap - self.width;
        y: (parent.height - self.height) / 2;
        label: root.item.due;
        visible: root.show-tag;
    }

    prio := PriorityDots {
        x: parent.width - Layout.icon-size - Layout.icon-gap - root.tag-w - self.width;
        y: 0;
        height: parent.height;
        level: root.item.priority;
        revealed: root.hovered;
        visible: !root.editing;
        cycled => { root.priority-cycled(); }
    }

    del := IconButton {
        x: parent.width - Layout.icon-size;
        y: (parent.height - Layout.header-h) / 2;
        width: Layout.icon-size;
        revealed: root.hovered;
        activated => { root.remove(); }
        IconTrash { stroke-color: del.glyph-color; }
    }
}

export component TodoWindow inherits Window {
    in-out property <string> note-title: "UNTITLED";
    in property <[TodoItemData]> items: [];
    in property <int> open-count: 0;
    in property <int> done-count: 0;
    in property <WidgetState> strip-state: WidgetState.idle;
    in property <int> peer-count: 0;
    in-out property <bool> pinned: false;
    in property <bool> keyboard-focused: false;

    in-out property <string> editing-id: "";

    callback window-moved(length, length);
    callback drag-started();
    callback drag-ended();
    callback item-toggled(string);
    callback item-text-edited(string, string);
    callback item-removed(string);
    callback item-added(string);
    callback item-priority-cycled(string);
    callback item-moved(string, int);
    callback edit-committed();
    callback pin-toggled(bool);
    callback delete-confirmed();
    callback title-edited(string);
    callback close-requested();
    callback palette-requested();

    preferred-width: Layout.todo-w + 2 * Layout.plate-margin;
    preferred-height: Layout.todo-h + 2 * Layout.plate-margin;
    min-width: Layout.note-min-w + 2 * Layout.plate-margin;
    min-height: Layout.note-min-h + 2 * Layout.plate-margin;
    no-frame: true;
    in-out property <length> resize-border: Layout.resize-border;
    resize-border-width: root.resize-border;
    background: transparent;
    title: "Canvas";

    in-out property <bool> opened: false;
    in-out property <bool> closing: false;

    property <bool> dragging: false;
    property <bool> confirming-delete: false;
    property <bool> editing-title: false;

    property <WidgetState> effective-state:
        (root.strip-state == WidgetState.idle && (root.editing-id != "" || new-input.has-focus))
            ? WidgetState.focused
            : root.strip-state;

    property <bool> controls-visible:
        drag-area.has-hover
        || pin-btn.hovered || pin-btn.focused
        || trash-btn.hovered || trash-btn.focused
        || close-btn.hovered || close-btn.focused
        || root.editing-title;

    property <length> confirm-h: Layout.confirm-band;
    property <length> footer-h: Layout.footer-band;
    property <length> compose-band: 2 * Layout.pad + Layout.checkbox-row-h;
    property <length> row-step: Layout.todo-row-h + Layout.todo-row-gap;

    property <string> held-id: "";
    property <length> held-y: 0px;
    property <length> held-dy: 0px;
    property <int> drop-index: 0;

    pure function index-at(y: length) -> int {
        return clamp(
            round((y - Layout.ring + root.row-step / 2) / root.row-step),
            0,
            root.items.length - 1);
    }

    function commit-new() {
        if (new-input.text != "") {
            root.item-added(new-input.text);
            new-input.text = "";
        }
        new-input.focus();
    }

    property <length> list-top: Layout.body-top + Layout.pad;
    property <length> list-bottom: plate.height - root.footer-h - root.compose-band
        - (root.confirming-delete ? root.confirm-h : 0px);

    plate := Panel {
        x: Layout.plate-margin;
        y: Layout.plate-margin + (root.opened ? 0px : Motion.open-rise);
        width: parent.width - 2 * Layout.plate-margin;
        height: parent.height - 2 * Layout.plate-margin;
        corner-radius: Layout.radius-plate;
        dragging: root.dragging;

        opacity: root.closing ? 0.0 : (root.opened ? 1.0 : 0.0);
        animate y { duration: Motion.open; easing: Ease.standard; }
        animate opacity {
            duration: root.closing ? Motion.close : Motion.open;
            easing: Ease.standard;
        }

        if root.keyboard-focused: Rectangle {
            x: -(Layout.focus-offset + Layout.focus-width);
            y: -(Layout.focus-offset + Layout.focus-width);
            width: parent.width + 2 * (Layout.focus-offset + Layout.focus-width);
            height: parent.height + 2 * (Layout.focus-offset + Layout.focus-width);
            background: transparent;
            border-width: Layout.focus-width;
            border-color: Palette.text;
            border-radius: Layout.radius-plate + Layout.focus-offset + Layout.focus-width;
        }

        list-area := Rectangle {
            x: Layout.pad - Layout.ring;
            y: root.list-top - Layout.ring;
            width: parent.width - 2 * Layout.pad + Layout.ring;
            height: root.list-bottom - root.list-top + 2 * Layout.ring;
            clip: true;

            if root.items.length == 0: Text {
                x: Layout.ring;
                y: Layout.ring;
                width: parent.width;
                text: "NOTHING HERE YET";
                color: Palette.text;
                opacity: Layout.placeholder-opacity;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                overflow: elide;
                wrap: no-wrap;
            }

            rows-scroll := Flickable {
                x: 0;
                y: 0;
                width: parent.width - Layout.scroll-gutter;
                height: 100%;
                interactive: false;
                viewport-height: max(
                    2 * Layout.ring + root.items.length * root.row-step - Layout.todo-row-gap,
                    self.height);

                for entry[idx] in root.items: ItemRow {
                    x: Layout.ring;
                    y: Layout.ring + idx * root.row-step;
                    width: parent.width - 2 * Layout.ring;
                    item: entry;
                    editing: root.editing-id == entry.id;
                    held: root.held-id == entry.id;
                    toggled => { root.item-toggled(entry.id); }
                    text-edited(value) => { root.item-text-edited(entry.id, value); }
                    commit => { root.edit-committed(); }
                    remove => { root.item-removed(entry.id); }
                    begin-edit => { root.editing-id = entry.id; }
                    priority-cycled => { root.item-priority-cycled(entry.id); }
                    drag-moved(dy) => {
                        root.held-id = entry.id;
                        root.held-y = Layout.ring + idx * root.row-step;
                        root.held-dy = dy;
                        root.drop-index = root.index-at(root.held-y + dy);
                    }
                    drag-ended => {
                        if (root.held-id == entry.id) {
                            if (root.drop-index != idx) {
                                root.item-moved(entry.id, root.drop-index);
                            }
                            root.held-id = "";
                            root.held-dy = 0px;
                        }
                    }
                }

                if root.held-id != "": Rectangle {
                    x: Layout.ring;
                    y: root.held-y + root.held-dy;
                    width: parent.width - 2 * Layout.ring;
                    height: Layout.todo-row-h;
                    background: Palette.elev-raised;
                    border-radius: Layout.radius-control;
                    border-width: 1px;
                    border-color: Palette.edge;
                }
            }

            if root.held-id != "": Rectangle {
                x: Layout.ring;
                y: Layout.ring + rows-scroll.viewport-y + root.drop-index * root.row-step
                    - Layout.todo-row-gap / 2;
                width: parent.width - Layout.scroll-gutter - 2 * Layout.ring;
                height: 1px;
                background: Palette.text;
            }

            ScrollBar {
                x: parent.width - Layout.scroll-gutter;
                y: Layout.ring;
                height: parent.height - 2 * Layout.ring;
                view-height: rows-scroll.height;
                viewport-height: rows-scroll.viewport-height;
                viewport-y <=> rows-scroll.viewport-y;
            }
        }

        compose := Rectangle {
            x: Layout.pad;
            y: root.list-bottom + Layout.pad;
            width: parent.width - 2 * Layout.pad;
            height: Layout.checkbox-row-h;
            visible: !root.confirming-delete;

            add-btn := IconButton {
                x: 0;
                y: (parent.height - Layout.header-h) / 2;
                width: Layout.checkbox-size;
                enabled: new-input.text != "";
                activated => { root.commit-new(); }
                IconPlus {
                    size: Layout.checkbox-size;
                    stroke-color: new-input.has-focus || add-btn.hovered
                        ? Palette.text
                        : Palette.dim;
                }
            }

            new-input := TextInput {
                x: Layout.checkbox-size + Layout.checkbox-gap;
                y: 0;
                width: parent.width - self.x;
                height: parent.height;
                single-line: true;
                vertical-alignment: center;
                color: Palette.text;
                selection-background-color: Palette.edge;
                selection-foreground-color: Palette.text;
                text-cursor-width: Layout.caret-w;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                accepted => { root.commit-new(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        new-input.clear-focus();
                        return accept;
                    }
                    if (event.modifiers.control && event.text == "k") {
                        root.palette-requested();
                        return accept;
                    }
                    return reject;
                }
            }

            if new-input.text == "" && !new-input.has-focus: Text {
                x: Layout.checkbox-size + Layout.checkbox-gap;
                y: 0;
                width: parent.width - self.x;
                height: parent.height;
                vertical-alignment: center;
                text: "Add an item";
                color: Palette.text;
                opacity: Layout.placeholder-opacity;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                overflow: elide;
                wrap: no-wrap;
            }
        }

        footer-rule := Rectangle {
            x: 0;
            y: parent.height - root.footer-h;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        Text {
            x: Layout.pad;
            y: footer-rule.y;
            width: parent.width - 2 * Layout.pad;
            height: root.footer-h;
            vertical-alignment: center;
            text: root.open-count + " OPEN · " + root.done-count + " DONE";
            color: Palette.dim;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
            overflow: elide;
            wrap: no-wrap;
        }

        pin-btn := IconButton {
            x: parent.width - Layout.pad - Layout.cluster-w;
            y: Layout.header-y;
            width: Layout.icon-size + Layout.icon-gap;
            revealed: root.controls-visible;
            activated => {
                root.pinned = !root.pinned;
                root.pin-toggled(root.pinned);
            }
            IconPin {
                stroke-color: root.pinned ? Palette.text : pin-btn.glyph-color;
            }
        }

        trash-btn := IconButton {
            x: close-btn.x - Layout.icon-size - Layout.icon-gap;
            y: Layout.header-y;
            width: Layout.icon-size + Layout.icon-gap;
            revealed: root.controls-visible;
            activated => { root.confirming-delete = true; }
            IconTrash { stroke-color: trash-btn.glyph-color; }
        }

        close-btn := IconButton {
            x: parent.width - Layout.pad - Layout.icon-size;
            y: Layout.header-y;
            width: Layout.icon-size;
            revealed: root.controls-visible;
            activated => { root.close-requested(); }
            IconX { stroke-color: close-btn.glyph-color; }
        }

        drag-area := TouchArea {
            x: 0;
            y: 0;
            width: pin-btn.x - Layout.icon-gap;
            height: Layout.header-band;
            moved => {
                if (!root.dragging) {
                    root.dragging = true;
                    root.drag-started();
                }
                root.window-moved(
                    self.mouse-x - self.pressed-x,
                    self.mouse-y - self.pressed-y
                );
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.drag-ended();
                }
            }
            double-clicked => { root.editing-title = true; }
        }

        Rectangle {
            x: Layout.pad;
            y: Layout.header-y;
            width: Layout.strip-w;
            height: Layout.header-h;
            GlyphStrip {
                x: 0;
                y: (Layout.header-h - Layout.strip-h) / 2;
                width: Layout.strip-w;
                height: Layout.strip-h;
                state: root.effective-state;
                peer-count: root.peer-count;
            }
        }

        if !root.editing-title: Text {
            x: Layout.title-x;
            y: Layout.header-y;
            width: pin-btn.x - Layout.gap-m - self.x;
            height: Layout.header-h;
            text: root.note-title;
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.title-size;
            letter-spacing: Typography.title-tracking;
            vertical-alignment: center;
            horizontal-alignment: left;
            overflow: elide;
            wrap: no-wrap;
        }

        if root.editing-title: Rectangle {
            x: Layout.title-x - Layout.edit-inset;
            y: Layout.header-y;
            width: pin-btn.x - Layout.gap-m - self.x;
            height: Layout.header-h;
            background: Palette.elev-recessed;
            border-radius: Layout.radius-control;
            border-width: 1px;
            border-color: Palette.edge;

            title-input := TextInput {
                x: Layout.edit-inset;
                y: 0;
                width: parent.width - 2 * Layout.edit-inset;
                height: parent.height;
                text: root.note-title;
                single-line: true;
                vertical-alignment: center;
                color: Palette.text;
                selection-background-color: Palette.edge;
                selection-foreground-color: Palette.text;
                text-cursor-width: Layout.caret-w;
                font-family: Typography.interface-face;
                font-size: Typography.title-size;
                letter-spacing: Typography.title-tracking;
                init => { self.focus(); self.select-all(); }
                edited => { root.title-edited(self.text); }
                accepted => {
                    root.editing-title = false;
                    new-input.focus();
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.editing-title = false;
                        new-input.focus();
                        return accept;
                    }
                    return reject;
                }
            }
        }

        Rectangle {
            x: 0;
            y: Layout.header-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        if root.confirming-delete: Rectangle {
            x: 0;
            y: parent.height - Layout.pad - root.confirm-h;
            width: parent.width;
            height: root.confirm-h;
            background: Palette.plate;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 1px;
                background: Palette.edge;
            }

            Text {
                x: Layout.pad;
                y: Layout.pad;
                text: "DELETE — CANNOT BE UNDONE";
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }

            HorizontalLayout {
                x: Layout.pad;
                y: Layout.pad + Typography.label-line + Layout.gap-m;
                height: Layout.button-h;
                spacing: Layout.icon-gap;
                alignment: start;

                Button {
                    label: "DELETE LIST";
                    variant: ButtonVariant.destructive;
                    clicked => { root.delete-confirmed(); }
                }
                Button {
                    label: "CANCEL";
                    variant: ButtonVariant.default;
                    clicked => {
                        root.confirming-delete = false;
                        new-input.focus();
                    }
                }
            }

            FocusScope {
                width: 0px;
                height: 0px;
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.confirming-delete = false;
                        new-input.focus();
                        return accept;
                    }
                    return reject;
                }
            }
        }
    }

    init => { new-input.focus(); }
}
