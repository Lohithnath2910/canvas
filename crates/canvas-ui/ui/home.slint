import { Palette } from "theme/palette.slint";
import { Typography } from "theme/typography.slint";
import { Motion, Ease } from "theme/motion.slint";
import { Layout } from "theme/layout.slint";
import { Panel } from "theme/surface.slint";
import { GlyphStrip, WidgetState } from "theme/glyphstrip.slint";
import { IconTrash, IconPlus, IconNote, IconCheck, IconColumns, IconCalendar, IconDoc, IconX } from "theme/icons.slint";
import { IconButton, Button, ButtonVariant, ScrollBar } from "theme/controls.slint";

export struct WidgetTypeData {
    kind: string,
    label: string,
}

export struct NoteRow {
    id: string,
    title: string,
    preview: string,
    kind: string,
    open: bool,
}

component KindGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> stroke-color: Palette.dim;
    width: Layout.icon-size;
    height: Layout.icon-size;

    if root.kind == "todo": IconCheck { stroke-color: root.stroke-color; }
    if root.kind == "kanban": IconColumns { stroke-color: root.stroke-color; }
    if root.kind == "calendar": IconCalendar { stroke-color: root.stroke-color; }
    if root.kind == "document": IconDoc { stroke-color: root.stroke-color; }
    if root.kind == "sticky_note": IconNote { stroke-color: root.stroke-color; }
}

component Row inherits Rectangle {
    in property <NoteRow> item;
    callback activated();
    callback delete-requested();

    height: 56px;

    out property <bool> hovered: touch.has-hover;

    property <length> dots-w: 2 * Layout.dot-size + Layout.dot-gap;
    property <length> glyph-x: Layout.pad + root.dots-w + Layout.gap-m;
    property <length> text-x: root.glyph-x + Layout.icon-size + Layout.gap-m;
    property <length> tail: Layout.pad + Layout.icon-size + Layout.gap-m;

    background: (touch.has-hover || focus.has-focus)
        ? Palette.elev-raised
        : Colors.transparent;
    animate background { duration: Motion.hover; easing: Ease.standard; }

    focus := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            if (event.text == Key.Delete) {
                root.delete-requested();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        width: parent.width - root.tail;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.activated();
        }
    }

    Rectangle {
        x: Layout.pad;
        y: (parent.height - Layout.strip-h) / 2;
        width: root.dots-w;
        height: Layout.strip-h;
        HorizontalLayout {
            spacing: Layout.dot-gap;
            for i in 2: Rectangle {
                width: Layout.dot-size;
                height: Layout.dot-size;
                background: root.item.open
                    ? (i == 0 ? Palette.dot-lit : Palette.dot-lit)
                    : (i == 0 ? Palette.dot-half : Palette.dot-unlit);
            }
        }
    }

    KindGlyph {
        x: root.glyph-x;
        y: (parent.height - self.height) / 2;
        kind: root.item.kind;
        stroke-color: touch.has-hover ? Palette.text : Palette.dim;
    }

    VerticalLayout {
        x: root.text-x;
        y: 10px;
        width: parent.width - self.x - root.tail;
        spacing: 2px;

        Text {
            text: root.item.title;
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.label-size;
            letter-spacing: Typography.label-tracking;
            overflow: elide;
            wrap: no-wrap;
        }
        Text {
            text: root.item.preview == "" ? "Empty" : root.item.preview;
            color: Palette.dim;
            font-family: Typography.body-face;
            font-size: Typography.body-size;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    del := IconButton {
        x: parent.width - Layout.pad - Layout.icon-size;
        y: (parent.height - Layout.header-h) / 2;
        width: Layout.icon-size;
        revealed: touch.has-hover || focus.has-focus || del.hovered;
        activated => { root.delete-requested(); }
        IconTrash { stroke-color: del.glyph-color; }
    }

    if focus.has-focus: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-width: Layout.focus-width;
        border-color: Palette.text;
        border-radius: Layout.radius-control;
    }
}

export component HomeWindow inherits Window {
    in property <[NoteRow]> rows: [];
    in property <[WidgetTypeData]> types: [];
    in property <int> open-count: 0;

    callback create-widget(string);
    callback open-row(string);
    callback delete-row(string);
    callback window-moved(length, length);
    callback drag-started();
    callback drag-ended();
    callback quit-requested();
    callback close-requested();

    preferred-width: 420px + 2 * Layout.plate-margin;
    preferred-height: 520px + 2 * Layout.plate-margin;
    min-width: 340px + 2 * Layout.plate-margin;
    min-height: 300px + 2 * Layout.plate-margin;
    no-frame: true;
    in-out property <length> resize-border: Layout.resize-border;
    resize-border-width: root.resize-border;
    background: transparent;
    title: "Canvas";

    in-out property <bool> opened: false;
    in-out property <bool> closing: false;

    property <bool> dragging: false;
    property <string> pending-delete: "";
    property <string> type-label: "NEW";

    plate := Panel {
        x: Layout.plate-margin;
        y: Layout.plate-margin + (root.opened ? 0px : Motion.open-rise);
        width: parent.width - 2 * Layout.plate-margin;
        height: parent.height - 2 * Layout.plate-margin;
        corner-radius: Layout.radius-plate;
        dragging: root.dragging;

        opacity: root.closing ? 0.0 : (root.opened ? 1.0 : 0.0);
        animate y { duration: Motion.open; easing: Ease.standard; }
        animate opacity {
            duration: root.closing ? Motion.close : Motion.open;
            easing: Ease.standard;
        }

        drag-area := TouchArea {
            x: 0;
            y: 0;
            width: home-close.x - Layout.icon-gap;
            height: Layout.header-band;
            moved => {
                if (!root.dragging) {
                    root.dragging = true;
                    root.drag-started();
                }
                root.window-moved(
                    self.mouse-x - self.pressed-x,
                    self.mouse-y - self.pressed-y
                );
            }
            pointer-event(event) => {
                if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.drag-ended();
                }
            }
        }

        Rectangle {
            x: Layout.pad;
            y: Layout.header-y;
            width: Layout.strip-w;
            height: Layout.header-h;
            GlyphStrip {
                x: 0;
                y: (Layout.header-h - Layout.strip-h) / 2;
                width: Layout.strip-w;
                height: Layout.strip-h;
                state: root.open-count > 0 ? WidgetState.focused : WidgetState.idle;
            }
        }

        home-close := IconButton {
            x: parent.width - Layout.pad - Layout.icon-size;
            y: Layout.header-y;
            width: Layout.icon-size;
            revealed: true;
            activated => { root.close-requested(); }
            IconX { stroke-color: home-close.glyph-color; }
        }

        Text {
            x: Layout.title-x;
            y: Layout.header-y;
            width: home-close.x - Layout.icon-gap - self.x;
            height: Layout.header-h;
            text: "CANVAS";
            color: Palette.text;
            font-family: Typography.interface-face;
            font-size: Typography.title-size;
            letter-spacing: Typography.title-tracking;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }

        Rectangle {
            x: 0;
            y: Layout.header-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        if root.rows.length == 0: Rectangle {
            x: Layout.pad;
            y: Layout.header-band + 1px;
            width: parent.width - 2 * Layout.pad;
            height: parent.height - self.y - Layout.footer-band;

            empty-title := Text {
                x: 0;
                y: (parent.height - self.height - 12px - empty-hint.height) / 2;
                width: parent.width;
                text: "NOTHING HERE YET";
                color: Palette.text;
                horizontal-alignment: center;
                font-family: Typography.interface-face;
                font-size: Typography.title-size;
                letter-spacing: Typography.title-tracking;
                overflow: elide;
                wrap: no-wrap;
            }

            empty-hint := Text {
                x: 0;
                y: empty-title.y + empty-title.height + 12px;
                width: parent.width;
                text: "Press Ctrl+K, or pick a type below.";
                color: Palette.dim;
                horizontal-alignment: center;
                font-family: Typography.body-face;
                font-size: Typography.body-size;
                wrap: word-wrap;
            }
        }

        if root.rows.length > 0: Rectangle {
            x: 0;
            y: Layout.header-band + 1px;
            width: parent.width;
            height: parent.height - self.y - Layout.footer-band;

            rows-scroll := Flickable {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                viewport-height: max(rows-layout.preferred-height, self.height);

                rows-layout := VerticalLayout {
                    width: 100%;
                    alignment: start;
                    for row in root.rows: Row {
                        item: row;
                        activated => { root.open-row(row.id); }
                        delete-requested => { root.pending-delete = row.id; }
                    }
                }
            }

            ScrollBar {
                x: parent.width - Layout.scroll-gutter;
                y: 0;
                height: parent.height;
                view-height: rows-scroll.height;
                viewport-height: rows-scroll.viewport-height;
                viewport-y <=> rows-scroll.viewport-y;
            }
        }

        Rectangle {
            x: 0;
            y: parent.height - Layout.footer-band;
            width: parent.width;
            height: 1px;
            background: Palette.edge;
        }

        Rectangle {
            x: Layout.pad;
            y: parent.height - Layout.footer-band + Layout.header-y;
            width: parent.width - 2 * Layout.pad;
            height: Layout.header-h;

            for entry[idx] in root.types: IconButton {
                x: idx * (Layout.icon-size + Layout.icon-gap);
                y: 0;
                width: Layout.icon-size;
                activated => { root.create-widget(entry.kind); }
                changed hovered => {
                    if (self.hovered) {
                        root.type-label = entry.label;
                    } else if (root.type-label == entry.label) {
                        root.type-label = "NEW";
                    }
                }
                changed focused => {
                    if (self.focused) {
                        root.type-label = entry.label;
                    } else if (root.type-label == entry.label) {
                        root.type-label = "NEW";
                    }
                }
                KindGlyph {
                    kind: entry.kind;
                    stroke-color: parent.glyph-color;
                }
            }

            Text {
                x: root.types.length * (Layout.icon-size + Layout.icon-gap);
                y: 0;
                width: max(0px, parent.width - self.x - type-count.width - Layout.gap-m);
                height: parent.height;
                vertical-alignment: center;
                text: root.type-label;
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                overflow: elide;
                wrap: no-wrap;
            }

            type-count := Text {
                x: parent.width - self.width;
                y: 0;
                height: parent.height;
                vertical-alignment: center;
                text: root.rows.length + " WIDGETS · " + root.open-count + " OPEN";
                color: Palette.dim;
                font-family: Typography.interface-face;
                font-size: Typography.label-size;
                letter-spacing: Typography.label-tracking;
                wrap: no-wrap;
            }
        }

        if root.pending-delete != "": Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: Palette.scrim;
            border-radius: Layout.radius-plate;

            TouchArea { width: 100%; height: 100%; }

            Rectangle {
                x: Layout.pad;
                y: (parent.height - Layout.confirm-band - Layout.pad) / 2;
                width: parent.width - 2 * Layout.pad;
                height: Layout.confirm-band + Layout.pad;
                background: Palette.plate;
                border-radius: Layout.radius-control;
                border-width: 1px;
                border-color: Palette.edge;

                Text {
                    x: Layout.pad;
                    y: Layout.pad;
                    text: "DELETE — CANNOT BE UNDONE";
                    color: Palette.dim;
                    font-family: Typography.interface-face;
                    font-size: Typography.label-size;
                    letter-spacing: Typography.label-tracking;
                    wrap: no-wrap;
                }

                HorizontalLayout {
                    x: Layout.pad;
                    y: Layout.pad + Typography.label-line + Layout.gap-m;
                    height: Layout.button-h;
                    spacing: Layout.icon-gap;
                    alignment: start;

                    Button {
                        label: "DELETE NOTE";
                        variant: ButtonVariant.destructive;
                        clicked => {
                            root.delete-row(root.pending-delete);
                            root.pending-delete = "";
                        }
                    }
                    Button {
                        label: "CANCEL";
                        variant: ButtonVariant.default;
                        clicked => { root.pending-delete = ""; }
                    }
                }
            }
        }
    }

    FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Escape && root.pending-delete != "") {
                root.pending-delete = "";
                return accept;
            }
            return reject;
        }
    }
}
